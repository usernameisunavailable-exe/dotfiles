-- ~/.config/hypr/hyprland.lua

-- startup processes
hl.on("hyprland.start", function()
  hl.dsp.exec_cmd("dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP")
  hl.dsp.exec_cmd("elephant")
  hl.dsp.exec_cmd("waybar")
  hl.dsp.exec_cmd("hyprpaper")
  hl.dsp.exec_cmd("dunst")
  hl.dsp.exec_cmd("walker --gapplication-service")
  hl.dsp.exec_cmd("hyprctl setcursor GoogleDot-Black 24")
end)

-- standard top-level exec
hl.exec_cmd("swayosd-server")

-- environment variables
hl.env("XCURSOR_SIZE", "24")
hl.env("HYPRCURSOR_SIZE", "24")
hl.env("XCURSOR_THEME", "GoogleDot-Black")
hl.env("HYPRCURSOR_THEME", "GoogleDot-Black")

-- permissions
hl.permission("/usr/bin/wf-recorder", "screencopy", "allow")
hl.permission("/usr/bin/slurp", "screencopy", "allow")

-- monitors
hl.monitor("", "preferred", "auto", "auto")

-- main config block
hl.config({
  general = {
    gaps_in = 2,
    gaps_out = 10,
    border_size = 1,
    ["col.active_border"] = "rgba(0FAAA1FF)", 
    ["col.inactive_border"] = "rgba(201,201,216,0.66)",
    resize_on_border = false,
    allow_tearing = false,
    layout = "dwindle"
  },
  decoration = {
    rounding = 10,
    rounding_power = 2,
    active_opacity = 1.0,
    inactive_opacity = 0.93,
    shadow = {
      enabled = true,
      range = 4,
      render_power = 3,
      color = "rgba(1a1a1aee)"
    },
    blur = {
      enabled = true,
      size = 3,
      passes = 2,
      vibrancy = 0.1696
    }
  },
  animations = {
    enabled = true
  },
  master = {
    new_status = "master"
  },
  misc = {
    force_default_wallpaper = 0,
    disable_hyprland_logo = true
  },
  input = {
    kb_layout = "hu",
    follow_mouse = 1,
    accel_profile = "flat",
    sensitivity = 0.25,
    touchpad = {
      disable_while_typing = false,
      natural_scroll = true
    }
  }
})

-- curves & animations
hl.curve("easeOutQuint", 0.23, 1, 0.32, 1)
hl.curve("easeInOutCubic", 0.65, 0.05, 0.36, 1)
hl.curve("linear", 0, 0, 1, 1)
hl.curve("almostLinear", 0.5, 0.5, 0.75, 1)
hl.curve("quick", 0.15, 0, 0.1, 1)

hl.animation("global", 1, 10, "default")
hl.animation("border", 1, 5.39, "easeOutQuint")
hl.animation("windows", 1, 4.79, "easeOutQuint")
hl.animation("windowsIn", 1, 4.1, "easeOutQuint", "popin 87%")
hl.animation("windowsOut", 1, 1.49, "linear", "popin 87%")
hl.animation("fadeIn", 1, 1.73, "almostLinear")
hl.animation("fadeOut", 1, 1.46, "almostLinear")
hl.animation("fade", 1, 3.03, "quick")
hl.animation("layers", 1, 3.81, "easeOutQuint")
hl.animation("layersIn", 1, 4, "easeOutQuint", "fade")
hl.animation("layersOut", 1, 1.5, "linear", "fade")
hl.animation("fadeLayersIn", 1, 1.79, "almostLinear")
hl.animation("fadeLayersOut", 1, 1.39, "almostLinear")
hl.animation("workspaces", 1, 1.94, "almostLinear", "fade")
hl.animation("workspacesIn", 1, 1.21, "almostLinear", "fade")
hl.animation("workspacesOut", 1, 1.94, "almostLinear", "fade")
hl.animation("zoomFactor", 1, 7, "quick")

-- gestures and devices
hl.gesture({ fingers = 3, direction = "horizontal", action = "workspace" })
hl.device({ name = "epic-mouse-v1", sensitivity = -0.5 })

-- simple bindings
hl.bind("SUPER + R", hl.dsp.exec_cmd("wf-recorder -g \"$(slurp)\" -f ~/Videos/recording.mp4"))
hl.bind("SUPER + SHIFT + R", hl.dsp.exec_cmd("killall -s SIGINT wf-recorder"))
hl.bind("SUPER + S", hl.dsp.exec_cmd("hyprshot -m region"))
hl.bind("SUPER + 0", hl.dsp.exec_cmd("alacritty -e btop"))
hl.bind("SUPER + ALT + S", hl.dsp.exec_cmd("~/.local/bin/ocr-screen.sh"))
hl.bind("SUPER + Q", hl.dsp.killactive())
hl.bind("SUPER + Return", hl.dsp.exec_cmd("alacritty"))
hl.bind("SUPER + space", hl.dsp.exec_cmd("walker"))
hl.bind("SUPER + M", hl.dsp.exec_cmd("command -v hyprshutdown >/dev/null 2>&1 && hyprshutdown || hyprctl dispatch exit"))
hl.bind("SUPER + E", hl.dsp.exec_cmd("thunar"))
hl.bind("SUPER + V", hl.dsp.togglefloating())
hl.bind("SUPER + B", hl.dsp.exec_cmd("firefox"))
hl.bind("SUPER + J", hl.dsp.layoutmsg("togglesplit"))
hl.bind("SUPER + SHIFT + B", hl.dsp.exec_cmd("hyprctl reload waybar"))

-- focus
hl.bind("SUPER + left", hl.dsp.movefocus("l"))
hl.bind("SUPER + right", hl.dsp.movefocus("r"))
hl.bind("SUPER + up", hl.dsp.movefocus("u"))
hl.bind("SUPER + down", hl.dsp.movefocus("d"))

-- standard workspaces
for i=1,9 do
  hl.bind("SUPER + " .. tostring(i), hl.dsp.workspace(tostring(i)))
  hl.bind("SUPER + SHIFT + " .. tostring(i), hl.dsp.movetoworkspace(tostring(i)))
end
hl.bind("SUPER + Ö", hl.dsp.workspace("10"))
hl.bind("SUPER + SHIFT + Ö", hl.dsp.movetoworkspace("10"))

-- special workspace
hl.bind("SUPER + CONTROL + S", hl.dsp.togglespecialworkspace("magic"))
hl.bind("SUPER + SHIFT + S", hl.dsp.movetoworkspace("special:magic"))

-- scrolling workspaces
hl.bind("SUPER + mouse_down", hl.dsp.workspace("e+1"))
hl.bind("SUPER + mouse_up", hl.dsp.workspace("e-1"))

-- window movement & sizing
-- note: the original 'bindm' config maps to { mouse = true } in the flags
hl.bind("SUPER + mouse:272", hl.dsp.movewindow(), { mouse = true })
hl.bind("SUPER + mouse:273", hl.dsp.resizewindow(), { mouse = true })

hl.bind("SUPER + SHIFT + left", hl.dsp.movewindow("l"))
hl.bind("SUPER + SHIFT + right", hl.dsp.movewindow("r"))
hl.bind("SUPER + SHIFT + up", hl.dsp.movewindow("u"))
hl.bind("SUPER + SHIFT + down", hl.dsp.movewindow("d"))

-- media and volume controls 
-- note: 'e' maps to repeating, 'l' maps to locked, 'r' maps to release
hl.bind("XF86MonBrightnessUp", hl.dsp.exec_cmd("brightnessctl -e4 -n2 set 5%+"), { repeating = true, locked = true })
hl.bind("XF86MonBrightnessDown", hl.dsp.exec_cmd("brightnessctl -e4 -n2 set 5%-"), { repeating = true, locked = true })
hl.bind("XF86AudioRaiseVolume", hl.dsp.exec_cmd("swayosd-client --output-volume raise"), { repeating = true, locked = true })
hl.bind("XF86AudioLowerVolume", hl.dsp.exec_cmd("swayosd-client --output-volume lower"), { repeating = true, locked = true })
hl.bind("XF86AudioMute", hl.dsp.exec_cmd("swayosd-client --output-volume mute-toggle"), { locked = true })
hl.bind("XF86AudioMicMute", hl.dsp.exec_cmd("swayosd-client --input-volume mute-toggle"), { locked = true })

hl.bind("Caps_Lock", hl.dsp.exec_cmd("swayosd-client --caps-lock"), { release = true })
