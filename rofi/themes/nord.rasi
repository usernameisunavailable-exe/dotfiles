/* ROFI VERTICAL THEME USING THE NORD COLOR PALETTE */
/* Author: Newman Sanchez (https://github.com/newmanls) */

* {
    font:   "Atkinson Hyperelegible Mono 12.5";

    /* Dark Neutral Palette */
    nord0:     #111111; /* black */
    nord1:     #1e1e2e; /* dark background base */
    nord2:     #282836; /* elevated surface layer */
    nord3:     #38384a; /* muted container/border */

    /* Light Neutral Palette */
    nord4:     #cccccc; /* white / foreground */
    nord5:     #cdd6f4; /* bright foreground */
    nord6:     #e0e0e0; /* high-contrast light */

    /* Cool Accent Palette */
    nord7:     #16a9a0; /* cyan */
    nord8:     #16a9a0; /* blue */
    nord9:     #5e93ce; /* soft blue variant */
    nord10:    #3b72ae; /* deep ocean blue */

    /* Warm & Accent Palette */
    nord11:    #d35c5c; /* red */
    nord12:    #d8a657; /* yellow / gold */
    nord13:    #e0b268; /* warm accent highlight */
    nord14:    #56b666; /* green */
    nord15:    #ad74cc; /* magenta */

    background-color:   transparent;
    text-color:         @nord4;
    accent-color:       @nord8;
}

window {
    background-color:   @nord0;
    border-color:       @accent-color;

    location:   center;
    width:      480px;
    border:     1px;
}

inputbar {
    padding:    8px 12px;
    spacing:    12px;
    children:   [ prompt, entry ];
}

prompt, entry, element-text, element-icon {
    vertical-align: 0.5;
}

prompt {
    text-color: @accent-color;
}

listview {
    lines:      8;
    columns:    1;

    fixed-height:   true;
}

element {
    padding:    8px;
    spacing:    8px;
}

element normal urgent {
    text-color: @nord13;
}

element normal active {
    text-color: @accent-color;
}

element alternate active {
    text-color: @accent-color;
}

element selected {
    text-color: @nord0;
}

element selected normal {
    background-color:   @accent-color;
}

element selected urgent {
    background-color:   @nord13;
}

element selected active {
    background-color:   @nord8;
}

element-icon {
    size:   0.75em;
}

element-text {
    text-color: inherit;
}
